{
  "name": "factory-manager",
  "version": "2.0.1",
  "private": true,
  "description": "Factory Manager - Arabic RTL PWA with Supabase authentication, local-first offline workspace, and cloud synchronization.",
  "scripts": {
    "dev": "vite",
    "test": "node tests/run.js",
    "serve": "node -e \"require('http').createServer((q,r)=>{const f=require('path').join(process.cwd(),q.url==='/'?'index.html':q.url.split('?')[0]);require('fs').createReadStream(f).on('error',()=>{r.statusCode=404;r.end()}).pipe(r)}).listen(8080,()=>console.log('http://localhost:8080'))\"",
    "build": "vite build"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
